@startuml lsm6dso_class

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    BorderColor Black
    HeaderBackgroundColor DarkRed
    HeaderFontColor White
    FontSize 12
    AttributeFontSize 11
}
skinparam enum {
    BackgroundColor LightYellow
    BorderColor DarkGoldenRod
}
skinparam ArrowColor DarkSlateGray
skinparam linetype ortho
left to right direction
skinparam nodesep 35
skinparam ranksep 60

' ──────────────────────────────────────────────
' Enums de configuración (principales)
' ──────────────────────────────────────────────
enum Lsm6dsoOdrAcc << (E,LightYellow) >> {
    POWER_DOWN
    ODR_1_6
    ODR_12_5
    ODR_26
    ODR_52
    ODR_104
    ODR_208
    ODR_416
    ODR_833
    ODR_1K66
    ODR_3K33
    ODR_6K66
}

enum Lsm6dsoFsAcc << (E,LightYellow) >> {
    FS_2G
    FS_16G
    FS_4G
    FS_8G
}

enum Lsm6dsoOdrGyr << (E,LightYellow) >> {
    POWER_DOWN
    ODR_12_5
    ODR_26
    ODR_52
    ODR_104
    ODR_208
    ODR_416
    ODR_833
    ODR_1K66
    ODR_3K33
    ODR_6K66
}

enum Lsm6dsoFsGyr << (E,LightYellow) >> {
    FS_250DPS
    FS_500DPS
    FS_1KDPS
    FS_2KDPS
}

enum Lsm6dsoWakeThs << (E,LightYellow) >> {
    THS_DISABLE = 0
    THS_1..THS_63
}

enum Lsm6dsoWakeDur << (E,LightYellow) >> {
    ODR_0
    ODR_1
    ODR_2
    ODR_3
}

enum Lsm6dsoWakeWeight << (E,LightYellow) >> {
    FS_XL_64
    FS_XL_256
}

enum Lsm6dsoSleepDur << (E,LightYellow) >> {
    DUR_0_512 .. DUR_15_512
}

enum Lsm6dsoI3C << (E,LightYellow) >> {
    ENABLED
    DISABLED
}

' ──────────────────────────────────────────────
' Dependencia bus
' ──────────────────────────────────────────────
class I2CBus << (C,LightGray) >>

' ──────────────────────────────────────────────
' Clase principal
' ──────────────────────────────────────────────
class Lsm6dso {
    ' ── Atributos públicos (datos acc [mg]) ─
    + ax          : float
    + ay          : float
    + az          : float
    + gx          : float
    + gy          : float
    + gz          : float
    + temperature : float

    ' ── Datos raw ───────────────────────────
    + axRaw   : int16_t
    + ayRaw   : int16_t
    + azRaw   : int16_t
    + gxRaw   : int16_t
    + gyRaw   : int16_t
    + gzRaw   : int16_t
    + tempRaw : int16_t

    ' ── Constructor ─────────────────────────
    + Lsm6dso()

    ' ── Inicialización ──────────────────────
    + init() : bool

    ' ── Lecturas ────────────────────────────
    + readAcceleration() : I2CResult
    + readGyroscope()    : I2CResult
    + readTemperature()  : I2CResult
    + getWhoAmI()        : I2CResult

    ' ── Test ────────────────────────────────
    + testIMU() : void

    ' ── Atributos privados ──────────────────
    - i2cAddr     : uint8_t
    - i2cBus      : I2CBus*
    - initialized : bool

    ' ── Métodos privados ────────────────────
    - configure() : bool
    - writeRegister() : I2CResult
    - readRegister()  : I2CResult
    - readRegisters() : I2CResult
}

' ──────────────────────────────────────────────
' Relaciones
' ──────────────────────────────────────────────
Lsm6dso "1" *-- "1"  I2CBus         : usa (I2C2) >
Lsm6dso ..>  Lsm6dsoOdrAcc     : <<parámetro>>
Lsm6dso ..>  Lsm6dsoFsAcc      : <<parámetro>>
Lsm6dso ..>  Lsm6dsoOdrGyr     : <<parámetro>>
Lsm6dso ..>  Lsm6dsoFsGyr      : <<parámetro>>
Lsm6dso ..>  Lsm6dsoWakeThs    : <<parámetro>>
Lsm6dso ..>  Lsm6dsoWakeDur    : <<parámetro>>
Lsm6dso ..>  Lsm6dsoWakeWeight : <<parámetro>>
Lsm6dso ..>  Lsm6dsoSleepDur   : <<parámetro>>
Lsm6dso ..>  Lsm6dsoI3C        : <<parámetro>>

@enduml
