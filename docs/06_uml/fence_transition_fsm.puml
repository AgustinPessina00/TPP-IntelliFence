@startuml fence_transition_fsm
title TPP-IntelliFence -- Fence Transition FSM (FenceTransitionState_t)

skinparam state {
    BorderColor     Black
    FontSize        12
    ArrowFontSize   10
    BackgroundColor White
    MinimumWidth    370
}
skinparam ArrowColor DarkSlateGray

note as N_entry
  El nuevo cerco fue procesado en fsmTask.cpp
  (processFenceMessage) ANTES de entrar.
  fence.getHasValidFence() == true al ingresar.
end note

[*] --> BEGIN

state "FENCE_TRANSITION_BEGIN" as BEGIN
state "FENCE_TRANSITION_DISABLE_STIMULUS" as DIS_STIM     : Envia BLACK_ZONE al modulo de estimulo\npara desactivar el estimulo activo\nAbre timeout STIMULUS_TIMEOUT_MS
state "FENCE_TRANSITION_WAIT_STIMULUS_RESPONSE" as WAIT_STIM : Aguarda MSG_ID_STIMULUS_FEEDBACK\ndel modulo de estimulo
state "FENCE_TRANSITION_GPSRATE_FAST" as GPS_FAST         : [pass-through - pendiente de impl.]\nReservado: updateGpsAdqTime(GpsRate::FAST)
state "FENCE_TRANSITION_WAIT_GPS_ADQ_TIME" as WAIT_ADQ    : [pass-through - pendiente de impl.]\nReservado: espera confirmacion cambio GPS rate
state "FENCE_TRANSITION_REQUEST_POSITION" as REQ_POS      : Solicita posicion GPS actualizada\nsendMessage(MSG_ID_REQUEST_GPS, MODULE_GPS)\nAbre timeout GPS_TIMEOUT_MS
state "FENCE_TRANSITION_WAIT_POSITION" as WAIT_POS        : Aguarda MSG_ID_SEND_GPS\ndel modulo GPS
state "FENCE_TRANSITION_REQUEST_ZONE" as REQ_ZONE         : Calcula zona con nuevo cerco cargado\ngetZoneFromDistance(cow, fence)\ncow.updateCurrentZone() + updateDistanceToLimit()
state "FENCE_TRANSITION_END" as END                       : Transicion completa\nfenceTransitionState = BEGIN\nmainFSM = NORMAL_OPERATION
state "NORMAL_OPERATION [MainFSM_t]" as NORMAL_OP #LightGreen

BEGIN --> DIS_STIM

DIS_STIM  --> WAIT_STIM : sendZoneToStimulus(BLACK_ZONE, MODULE_STIMULUS)\nTimeout_Start(STIMULUS_TIMEOUT_MS)
WAIT_STIM --> WAIT_STIM : timeout -- estimulo no respondio\nreintenta: sendZoneToStimulus(BLACK_ZONE)

WAIT_STIM --> END      : [MSG_ID_STIMULUS_FEEDBACK] OK\nfence.getHasValidFence() == false\nsin cerco valido -- sale directamente

WAIT_STIM --> GPS_FAST : [MSG_ID_STIMULUS_FEEDBACK] OK\nfence.getHasValidFence() == true\nestimulo apagado, cerco disponible

GPS_FAST  --> WAIT_ADQ
WAIT_ADQ  --> REQ_POS

REQ_POS  --> WAIT_POS : sendMessage(MSG_ID_REQUEST_GPS, MODULE_GPS)\nTimeout_Start(GPS_TIMEOUT_MS)
WAIT_POS --> WAIT_POS : timeout -- GPS no respondio\nreintenta: sendMessage(MSG_ID_REQUEST_GPS)

WAIT_POS --> REQ_ZONE : [MSG_ID_SEND_GPS] posicion valida\nprocessGpsMessage() OK -- cow.updatePosition()

REQ_ZONE --> REQ_POS  : zona != GREEN_ZONE\nvaca aun fuera del cerco\nrepite adquisicion GPS

REQ_ZONE --> END      : zona == GREEN_ZONE\nvaca en zona segura con nuevo cerco

END --> NORMAL_OP : mainFSM = NORMAL_OPERATION\nnormalOpFSM retoma desde INITIALIZE

@enduml
