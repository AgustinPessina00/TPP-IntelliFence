@startuml startup_routine_fsm
title TPP-IntelliFence — Startup Routine FSM (StartupRoutineState_t)

skinparam state {
    BorderColor Black
    FontSize 12
    ArrowFontSize 11
}
skinparam ArrowColor DarkSlateGray

[*] --> STARTUP_ROUTINE_BEGIN

STARTUP_ROUTINE_BEGIN --> STARTUP_ROUTINE_WAIT_JOIN : inicializa\n(timeout 5 s)

STARTUP_ROUTINE_WAIT_JOIN --> STARTUP_ROUTINE_REQUEST_POSITION  : MSG_ID_LORA_JOINED
STARTUP_ROUTINE_WAIT_JOIN --> STARTUP_ROUTINE_WAIT_JOIN          : timeout → reinicia timeout\n(sigue esperando)

STARTUP_ROUTINE_REQUEST_POSITION --> STARTUP_ROUTINE_WAIT_POSITION : envía MSG_ID_REQUEST_GPS\n(timeout 10 s)

STARTUP_ROUTINE_WAIT_POSITION --> STARTUP_ROUTINE_REQUEST_GPS_CONFIGURATION_PSM : MSG_ID_SEND_GPS\n+ posición válida
STARTUP_ROUTINE_WAIT_POSITION --> STARTUP_ROUTINE_REQUEST_POSITION               : posición inválida\no timeout

STARTUP_ROUTINE_REQUEST_GPS_CONFIGURATION_PSM --> STARTUP_ROUTINE_WAIT_GPS_CONFIGURATION_PSM : envía MSG_ID_REQUEST_GPS_CONFIGURATION_PSM\n(timeout 20 s)

STARTUP_ROUTINE_WAIT_GPS_CONFIGURATION_PSM --> STARTUP_ROUTINE_SEND_POSITION_LORA           : MSG_ID_SEND_GPS_CONFIGURATION_PSM
STARTUP_ROUTINE_WAIT_GPS_CONFIGURATION_PSM --> STARTUP_ROUTINE_REQUEST_GPS_CONFIGURATION_PSM : timeout

STARTUP_ROUTINE_SEND_POSITION_LORA --> STARTUP_ROUTINE_WAIT_FENCE : envía MSG_ID_LORA_SEND_POSITION\n(timeout 10 s)

STARTUP_ROUTINE_WAIT_FENCE --> STARTUP_ROUTINE_REQUEST_ZONE : MSG_ID_LORA_VERTEXES_RECEIVED\n+ fence OK
STARTUP_ROUTINE_WAIT_FENCE --> STARTUP_ROUTINE_WAIT_FENCE  : timeout → reinicia timeout\n(sigue esperando)

STARTUP_ROUTINE_REQUEST_ZONE --> STARTUP_ROUTINE_END : calcula zona local\n(getZoneFromDistance)

STARTUP_ROUTINE_END --> STARTUP_ROUTINE_BEGIN : resetea estado interno

state fork_end <<choice>>
STARTUP_ROUTINE_END --> fork_end

fork_end --> NORMAL_OPERATION   : zona verde
fork_end --> FENCE_TRANSITION   : fuera de zona verde

state NORMAL_OPERATION   #LightGreen  : [MainFSM → NORMAL_OPERATION]
state FENCE_TRANSITION   #LightSalmon : [MainFSM → FENCE_TRANSITION]

@enduml
