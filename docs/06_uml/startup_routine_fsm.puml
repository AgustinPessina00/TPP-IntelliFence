@startuml startup_routine_fsm
title TPP-IntelliFence -- Startup Routine FSM (StartupRoutineState_t)

skinparam state {
    BorderColor     Black
    FontSize        12
    ArrowFontSize   10
    BackgroundColor White
}
skinparam ArrowColor DarkSlateGray

[*] --> BEGIN

state "STARTUP_ROUTINE_BEGIN" as BEGIN         : Punto de entrada de la rutina de inicio\nReinicia variables internas

state "STARTUP_ROUTINE_WAIT_JOIN" as WAIT_JOIN : Aguarda confirmacion de join OTAA\nal servidor LoRaWAN\n(timeout: 5 s, se reinicia en cada ciclo de espera)

state "STARTUP_ROUTINE_REQUEST_POSITION" as REQ_POS : Solicita posicion GPS inicial\nAbre timeout GPS_TIMEOUT_MS

state "STARTUP_ROUTINE_WAIT_POSITION" as WAIT_POS  : Aguarda respuesta del modulo GPS\n(MSG_ID_SEND_GPS)

state "STARTUP_ROUTINE_REQUEST_GPS_CONFIGURATION_PSM" as REQ_PSM : Solicita configuracion de\nPower Save Mode al modulo GPS\nAbre timeout GPS_PSM_TIMEOUT_MS

state "STARTUP_ROUTINE_WAIT_GPS_CONFIGURATION_PSM" as WAIT_PSM  : Aguarda confirmacion PSM\n(MSG_ID_SEND_GPS_CONFIGURATION_PSM)

state "STARTUP_ROUTINE_SEND_POSITION_LORA" as SEND_LORA : Empaqueta y envia posicion GPS\nal servidor via LoRaWAN\n(MSG_ID_LORA_SEND_POSITION)\nAbre timeout LORA_RX_TIMEOUT_MS

state "STARTUP_ROUTINE_WAIT_FENCE" as WAIT_FENCE : Aguarda downlink con vertices del cerco\n(MSG_ID_LORA_VERTEXES_RECEIVED)\nTimeout se reinicia al expirar -- espera indefinida

state "STARTUP_ROUTINE_REQUEST_ZONE" as REQ_ZONE : Calcula zona inicial con los limites recibidos\ngetZoneFromDistance(cow, fence)\ncow.updateCurrentZone()\ncow.updateDistanceToLimit()

state "STARTUP_ROUTINE_END" as END             : Evalua zona calculada\nReinicia startupRoutineState = BEGIN\nRedirige MainFSM segun zona

state "NORMAL_OPERATION [MainFSM_t]" as NORMAL_OP   #LightGreen
state "FENCE_TRANSITION [MainFSM_t]" as FENCE_TRANS #LightSalmon

BEGIN --> WAIT_JOIN : Timeout_Start(5 s)

WAIT_JOIN --> REQ_POS   : [MSG_ID_LORA_JOINED]\nLoRaWAN OTAA confirmado por stack CM0+
WAIT_JOIN --> WAIT_JOIN : timeout expirado (5 s)\nTimeout_Start(5 s) - sigue esperando join

REQ_POS --> WAIT_POS : sendMessage(MSG_ID_REQUEST_GPS, MODULE_GPS)\nTimeout_Start(GPS_TIMEOUT_MS)

WAIT_POS --> REQ_PSM  : [MSG_ID_SEND_GPS] posicion valida\nprocessGpsMessage() OK -- cow.updatePosition()
WAIT_POS --> REQ_POS  : posicion invalida (sin fix GPS) o timeout\nreintenta adquisicion

REQ_PSM --> WAIT_PSM : sendMessage(MSG_ID_REQUEST_GPS_CONFIGURATION_PSM)\nTimeout_Start(GPS_PSM_TIMEOUT_MS)

WAIT_PSM --> SEND_LORA : [MSG_ID_SEND_GPS_CONFIGURATION_PSM]\nPSM OK -- GPS pasa a modo de bajo consumo
WAIT_PSM --> REQ_PSM   : timeout -- reintenta configuracion PSM

SEND_LORA --> WAIT_FENCE : sendPosition(MSG_ID_LORA_SEND_POSITION)\nTimeout_Start(LORA_RX_TIMEOUT_MS)

WAIT_FENCE --> REQ_ZONE   : [MSG_ID_LORA_VERTEXES_RECEIVED]\nprocessFenceMessage() -- fence.createLimits()\ncerco guardado con N vertices
WAIT_FENCE --> WAIT_FENCE : timeout expirado\nTimeout_Start(LORA_RX_TIMEOUT_MS)\nsigue esperando downlink del servidor

REQ_ZONE --> END : Zona y distancia al limite calculadas\nlocalmente (sin comunicacion adicional)

state fork_out <<choice>>
END --> fork_out : isInGreenZone(cow)

fork_out --> NORMAL_OP   : == OK  mainFSM = NORMAL_OPERATION\nvaca dentro del cerco en zona verde
fork_out --> FENCE_TRANS : != OK  mainFSM = FENCE_TRANSITION\nvaca fuera de zona verde al iniciar

@enduml
